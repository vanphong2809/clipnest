ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Cookie Netscape, chỉ cấu hình ở máy/server; không commit.
COOKIES_FILE=
FFMPEG_LOCATION=
MAX_CONCURRENT_JOBS=2
MAX_PENDING_JOBS=6
MAX_STORED_JOBS=12
MAX_VIDEO_MB=80
MAX_ZIP_MB=300
MAX_STORAGE_MB=1024
FILE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=8
# Chỉ true trên Render Free, nơi toàn bộ HTTP đi qua edge Cloudflare.
TRUST_RENDER_PROXY=false
